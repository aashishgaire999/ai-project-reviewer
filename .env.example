# Optional. With a key here, visitors can review without bringing their own,
# limited to REVIEWS_PER_HOUR per IP. Without it, visitors must paste their own key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
REVIEWS_PER_HOUR=5
# Optional. Raises the GitHub API limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=
